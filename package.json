{
  "name": "loca",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Loca - 地図に残す、あの場所の記録（GitHub Pages で動く静的サイト）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run build && npm run verify && npm run test:scripts && npm run test:core",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:core": "node --test tests/core/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:rules": "npm run rules:build && firebase emulators:exec --only firestore --project demo-loca \"node --test --test-concurrency=1 tests/rules/*.test.mjs tests/store/*.test.mjs\"",
    "deploy:rules": "node scripts/deploy-rules.mjs",
    "rules:publish": "firebase deploy --only firestore:rules,firestore:indexes --project loca-d3792",
    "check:head": "node scripts/check-head.mjs",
    "rules:probe": "node scripts/probe-rules.mjs",
    "rules:diff": "node scripts/rules-diff.mjs",
    "release": "node scripts/release.mjs",
    "pages:wait": "node scripts/wait-pages.mjs",
    "admin:list": "node scripts/admins.mjs list",
    "admin:add": "node scripts/admins.mjs add",
    "admin:remove": "node scripts/admins.mjs remove",
    "admin:accounts": "node scripts/accounts.mjs",
    "migrate:video-index": "node scripts/migrate-video-index.mjs",
    "data:seed": "node scripts/make-seed-data.mjs",
    "data:equipment": "node scripts/make-equipment.mjs",
    "data:clear": "node scripts/clear-data.mjs",
    "data:sync": "node scripts/sync-firestore.mjs",
    "data:sync:check": "node scripts/sync-firestore.mjs --check",
    "data:sync-equipment": "node scripts/sync-equipment.mjs",
    "data:reset": "node scripts/reset-data.mjs",
    "data:purge": "node scripts/purge-deleted.mjs --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "rules:build": "node scripts/build-rules.mjs",
    "actions:warnings": "node scripts/actions-warnings.mjs",
    "probe": "node scripts/probe-run.mjs",
    "fs:read": "node scripts/fs-read.mjs",
    "heat:check": "node scripts/heat-check.mjs",
    "semantic:eval": "node scripts/semantic-eval.mjs",
    "semantic:vectors": "node scripts/semantic-vectors.mjs",
    "keys:check": "node scripts/api-key-check.mjs",
    "survey:key": "node scripts/setup-survey-key.mjs",
    "size:breakdown": "node scripts/size-breakdown.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@huggingface/transformers": "^4.3.0",
    "firebase": "^12.19.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
