rules_version = '2';

// Loca の Firestore セキュリティルール（ADR 0010）。
// 権限はすべてここで守る。クライアントの判定は表示の切り替えにしか使わない（決定 5）。
// ここに無いコレクションは、どこにも一致しないので読み書きとも拒否される。
//
// 時刻はすべて Firestore の Timestamp で持ち、書き込み時は serverTimestamp() を使う
// （rules では request.time と一致する）。epoch ms への変換はアダプタが行う。
//
// 確かめ方: npm run test:rules（エミュレータで tests/rules/ を実行する）
//
// firestore.rules は生成物。rules/*.rules を編集し、npm run rules:build でつなぐ（ADR 0020）。
// 部品は名前順につながる。最初の部品が service と match を開き、最後の部品が閉じる。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 共通 ----

    function signedIn() {
      return request.auth != null;
    }

    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    function isAdmin() {
      return signedIn() && exists(docPath('admins', request.auth.uid));
    }

    // ブラックリストの利用者はログインできても書き込めない（要件 5.x、判定 △）
    function canWrite() {
      return signedIn() && !exists(docPath('blacklist', request.auth.uid));
    }

    // プロフィール（users/{uid}）を登録済みか。投稿・撮影リクエスト・通報の作成に要る（要件 1.1・ADR 0019）
    function registered() {
      return exists(docPath('users', request.auth.uid));
    }

    function optString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function reqString(data, key, minLen, maxLen) {
      return data[key] is string && data[key].size() >= minLen && data[key].size() <= maxLen;
    }

    // ---- 利用者単位のレートリミット（要件 1.3）----
    // マーカーを書くときは、同じバッチで rateLimits/{uid} を
    // { lastWriteAt: serverTimestamp(), target: <マーカー ID> } に更新させる。
    // target が 1 つなので、1 回の書き込みで作れるマーカーは 1 件に限られる。

    function stampedFor(markerId) {
      let stamp = getAfter(docPath('rateLimits', request.auth.uid)).data;
      return stamp.lastWriteAt == request.time && stamp.target == markerId;
    }

    function validStamp(uid) {
      let d = request.resource.data;
      return canWrite()
        && request.auth.uid == uid
        && d.keys().hasOnly(['lastWriteAt', 'target'])
        && d.lastWriteAt == request.time
        && reqString(d, 'target', 1, 128);
    }

    match /rateLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if validStamp(uid);
      // 直前の書き込みから 6 秒以上あける（10 回/分に相当）
      allow update: if validStamp(uid)
        && request.time > resource.data.lastWriteAt + duration.value(6, 's');
      // 消して間隔をリセットさせない
      allow delete: if false;
    }

    // ---- マーカー ----

    // タグ（要件 3.3・ADR 0014）。値は英小文字のキーで、一覧は src/core/constants/tags.ts と同じ。
    // 映っているもの・雰囲気は必須、季節・時間帯・撮り方は任意（無いときは項目ごと省く）
    function optEnum(data, key, values) {
      return !(key in data) || data[key] in values;
    }

    function validTags(t) {
      return t is map
        && t.keys().hasOnly(['subject', 'mood', 'season', 'timeOfDay', 'style'])
        && t.keys().hasAll(['subject', 'mood'])
        && t.subject in ['nature', 'townscape', 'festival', 'food', 'transport', 'heritage', 'life']
        && t.mood in ['lively', 'calm', 'dreamy', 'grand', 'nostalgic', 'thrill']
        && optEnum(t, 'season', ['spring', 'summer', 'autumn', 'winter'])
        && optEnum(t, 'timeOfDay', ['sunrise', 'morning', 'daytime', 'evening', 'night'])
        && optEnum(t, 'style', ['aerial', 'walking', 'vehicle', 'fixed']);
    }

    // 現地メモ: 1〜80 字、改行なし。空は項目ごと省く
    function validMemo(d) {
      return !('memo' in d)
        || (d.memo is string && d.memo.size() <= 80 && d.memo.matches('[^\\r\\n]+'));
    }

    // 撮影機器（分類 → メーカー → シリーズ → モデル。ADR 0018）。分類のキーは src/core/constants/equipment.ts と同じ。
    // 未選択は空文字。組み合わせがマスタにあるかは画面が確かめる（マスタは公開データでルールから読めないため）
    function validEquipment(e) {
      return e is map
        && e.keys().hasOnly(['category', 'manufacturer', 'series', 'model'])
        && e.keys().hasAll(['category', 'manufacturer', 'series', 'model'])
        && e.category in ['', 'drone', 'mirrorless', 'cinema', 'action', 'gimbal', 'camera360', 'smartphone', 'camcorder', 'other']
        && reqString(e, 'manufacturer', 0, 80)
        && reqString(e, 'series', 0, 80)
        && reqString(e, 'model', 0, 80);
    }

    // 保存後の姿として正しいか（作成・更新の共通部分）
    // URL は動画 ID から作った正規の形だけを許す（同じ動画を別の書き方で二重登録させないため）
    function validMarker(d) {
      return d.keys().hasOnly([
          'youtubeUrl', 'videoId', 'lat', 'lng', 'tags', 'memo', 'equipment',
          'title', 'channelTitle', 'thumbnailUrl', 'prefecture', 'city',
          'ownerUid', 'createdBy', 'createdAt', 'updatedAt', 'deleted',
          // 応えた撮影リクエストの ID（T43）。作成のときだけ付けられる（validAnswers・keepsAnswers）
          'answers',
          // Actions だけが IAM の経路で書く（ADR 0017）。利用者の作成・更新では変えられない（touchesBatchOnly）
          'youtube', 'deletedReason',
          // 公式の紹介（提供元と根拠のページ）。運営が IAM の経路で書く。利用者は作成でも更新でも付けられない（ADR 0036）
          'official'])
        && d.keys().hasAll([
          'youtubeUrl', 'videoId', 'lat', 'lng', 'tags', 'equipment',
          'ownerUid', 'createdBy', 'createdAt', 'updatedAt', 'deleted'])
        && d.videoId is string && d.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && d.youtubeUrl == 'https://www.youtube.com/watch?v=' + d.videoId
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && validTags(d.tags)
        && validMemo(d)
        && validEquipment(d.equipment)
        && optString(d, 'title', 300)
        && optString(d, 'channelTitle', 200)
        && optString(d, 'thumbnailUrl', 500)
        && optString(d, 'prefecture', 20)
        && optString(d, 'city', 50)
        && reqString(d, 'ownerUid', 1, 128)
        && reqString(d, 'createdBy', 1, 100)
        && d.createdAt is timestamp
        && d.updatedAt == request.time
        && d.deleted is bool
        && (!('youtube' in d) || d.youtube is map)
        && (!('deletedReason' in d) || d.deletedReason in ['unavailable'])
        && validOfficial(d)
        && validAnswers(d);
    }

    // 公式の紹介: 提供元（出所の表示）と、公式と確かめたページ。ページは https か http の URL だけ（画面がリンクにする）
    function validOfficial(d) {
      return !('official' in d)
        || (d.official is map
          && d.official.keys().hasOnly(['provider', 'sourceUrl'])
          && d.official.size() == 2
          && reqString(d.official, 'provider', 1, 100)
          && reqString(d.official, 'sourceUrl', 1, 500)
          && d.official.sourceUrl.matches('^https?://[^\\s]+$'));
    }

    // 応えた撮影リクエストの ID の一覧（1〜10 件・重複なし・英数字 1〜40 字。T43）。リクエストがあるかは、依頼者が受け取るときに確かめる
    // 要素の形は join して 1 本の正規表現で見る。join は数値も文字列にするので、split し直して元の一覧と同じ（すべて文字列）かも見る。
    // markers.json に載るので長さを縛る
    function validAnswers(d) {
      return !('answers' in d)
        || (d.answers is list && d.answers.size() >= 1 && d.answers.size() <= 10
          && d.answers.toSet().size() == d.answers.size()
          && d.answers.join(',').matches('^[A-Za-z0-9]{1,40}(,[A-Za-z0-9]{1,40}){0,9}$')
          && d.answers.join(',').split(',') == d.answers);
    }

    // 応えた撮影リクエストは作成のあと変えられない。後から付け替えて炎を集めさせないため。管理者も外す向きだけ
    function keepsAnswers() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answers'])
        || (isAdmin() && resource.data.get('answers', []).hasAll(request.resource.data.get('answers', [])));
    }

    // Actions と運営の経路だけが書く項目（再生数など・消えた動画の論理削除の理由・公式の紹介）
    function touchesBatchOnly(keys) {
      return keys.hasAny(['youtube', 'deletedReason', 'official']);
    }

    // 通常の更新で変えられない項目（createdBy は下の「投稿者名をそろえる」更新だけが、いまのニックネームに変えられる）
    function keepsIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerUid', 'createdBy', 'createdAt']);
    }

    // ---- 動画の索引（重複の禁止と、動画 URL の禁止リスト）----
    // videos/{videoId} = { markerId, ownerUid }。マーカーの作成・動画の差し替えと同じバッチで作らせる。
    // 既にあれば作れないので、同じ動画は 1 件しか登録できない。管理者が blocked: true を付けた動画も同じ理由で登録できない。

    // この書き込みで新しく作られた索引が、このマーカーを指しているか
    function indexedFor(markerId, videoId) {
      let path = docPath('videos', videoId);
      return !exists(path)
        && existsAfter(path)
        && getAfter(path).data.markerId == markerId;
    }

    function isOwner() {
      return resource.data.ownerUid == request.auth.uid;
    }

    match /markers/{markerId} {
      // 閲覧は誰でも可（onSnapshot で差分を埋めるため。要件 1.4）
      allow read: if true;

      // 要件 1.1: 未認証では登録させない
      // 投稿者名はプロフィールのニックネーム。ニックネームを変えたら下の「投稿者名をそろえる」更新で追従させる
      allow create: if canWrite()
        && registered()
        && request.resource.data.createdBy == get(docPath('users', request.auth.uid)).data.nickname
        && stampedFor(markerId)
        && validMarker(request.resource.data)
        && indexedFor(markerId, request.resource.data.videoId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.deleted == false
        && !touchesBatchOnly(request.resource.data.keys());

      // 投稿者名を、いまのプロフィールのニックネームにそろえる（ADR 0019 決定 7）。
      // 本人が createdBy と updatedAt だけを変える。名前はその時点のニックネームにしかできないので、他人の名前は名乗れない。
      // ニックネームの変更と同じバッチでも後からでも通るよう getAfter で読む。印（レートリミット）は求めない
      allow update: if canWrite()
        && isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdBy', 'updatedAt'])
        // 名前が実際に変わるときだけ（updatedAt だけを進める「空の更新」を印なしで通さない）
        && request.resource.data.createdBy != resource.data.createdBy
        && request.resource.data.createdBy == getAfter(docPath('users', request.auth.uid)).data.nickname
        && request.resource.data.updatedAt == request.time;

      // 本人の論理削除（deleted を true にするだけ）は印なしで通す。アカウント削除でまとめて消すため（ADR 0021）。
      // 消すだけなので連打されても困らない。戻すのは管理者だけ（下の通常の更新）
      allow update: if canWrite()
        && isOwner()
        && resource.data.deleted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt'])
        && request.resource.data.deleted == true
        && request.resource.data.updatedAt == request.time;

      // 通常の更新は最後に置く（validMarker などで式を多く使う）。ルールは 1 回の評価で式 1000 個までなので、
      // 軽い条件（投稿者名をそろえる・本人の論理削除）を先に評価させ、重い条件で予算を使い切る前に通す（T43）
      // 要件 3.x: 本人は論理削除まで。削除済みは本人には戻せない
      // 要件 5.x: 管理者は誰のマーカーでも更新・論理削除・復元できる（一括操作のためレートリミットなし）
      allow update: if canWrite()
        && validMarker(request.resource.data)
        && keepsIdentity()
        && keepsAnswers()
        // 再生数と公式の紹介は誰も変えられない。論理削除の理由は、管理者が復元するときだけ外せる
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['youtube', 'official'])
        && (isAdmin() || !touchesBatchOnly(request.resource.data.diff(resource.data).affectedKeys()))
        // 動画を差し替えるなら、新しい動画の索引を同じバッチで作る
        && (request.resource.data.videoId == resource.data.videoId
          || indexedFor(markerId, request.resource.data.videoId))
        && (
          isAdmin()
          || (isOwner() && resource.data.deleted == false && stampedFor(markerId))
        );

      // 物理削除は管理者だけ（要件 1.4）
      allow delete: if canWrite() && isAdmin();
    }

    function indexOwnMarker(videoId) {
      let d = request.resource.data;
      let marker = getAfter(docPath('markers', d.markerId)).data;
      return d.keys().hasOnly(['markerId', 'ownerUid'])
        && d.ownerUid == request.auth.uid
        && existsAfter(docPath('markers', d.markerId))
        && marker.videoId == videoId
        && marker.ownerUid == request.auth.uid;
    }

    function blockInAdvance() {
      let d = request.resource.data;
      return isAdmin() && d.keys().hasOnly(['blocked', 'reason']) && d.blocked == true;
    }

    match /videos/{videoId} {
      // 画面が登録前に「登録済み・禁止」を知らせるため、誰でも読める
      allow read: if true;
      // 本人が、同じバッチで作る・差し替えるマーカーのために作る。
      // 管理者は、まだ登録されていない動画を前もって禁止できる
      allow create: if canWrite() && (indexOwnMarker(videoId) || blockInAdvance());
      // 禁止の印を付ける・外すのは管理者だけ
      allow update: if canWrite() && isAdmin();
      // 本人は、論理削除したか動画を差し替えたマーカーの索引だけ外せる（禁止の印が付いたものは外せない）
      allow delete: if canWrite() && (
        isAdmin()
        || (resource.data.ownerUid == request.auth.uid
          && resource.data.get('blocked', false) != true
          && (getAfter(docPath('markers', resource.data.markerId)).data.deleted == true
            || getAfter(docPath('markers', resource.data.markerId)).data.videoId != videoId))
      );
    }

    // ---- 撮影リクエスト（熱量 1〜5。1 利用者の合計も 5 まで）----
    // リクエストは 1 件ずつ requests/{id} に置き、同じバッチで heatBudgets/{uid} を
    // { used: 使った熱量の合計, target: <リクエスト ID> } に更新させる。
    // リクエスト側は「印が自分を指していること」、印側は「増えた分がリクエストの熱量と一致し、5 を超えないこと」を見る。
    // 取り下げ（本人の論理削除）も同じで、印を減らし、減った分が取り下げたリクエストの熱量と一致することを見る。熱量はその分戻る。
    // 地点ごとの集計（合計・件数）は画面と日次の同期がまとめる。

    function validRequest(d) {
      return d.keys().hasOnly([
          'lat', 'lng', 'heat', 'season', 'timeOfDay', 'style', 'equipment',
          'ownerUid', 'createdAt', 'updatedAt', 'withdrawn'])
        && d.keys().hasAll(['lat', 'lng', 'heat', 'equipment', 'ownerUid', 'createdAt', 'updatedAt'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.heat is int && d.heat >= 1 && d.heat <= 5
        // 季節・時間帯・撮り方は動画のタグと同じキー（ADR 0014）。未選択は項目ごと省く
        && optEnum(d, 'season', ['spring', 'summer', 'autumn', 'winter'])
        && optEnum(d, 'timeOfDay', ['sunrise', 'morning', 'daytime', 'evening', 'night'])
        && optEnum(d, 'style', ['aerial', 'walking', 'vehicle', 'fixed'])
        && validEquipment(d.equipment)
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /requests/{requestId} {
      allow read: if true;
      allow create: if canWrite()
        && registered()
        && validRequest(request.resource.data)
        && request.resource.data.get('withdrawn', false) == false
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(docPath('heatBudgets', request.auth.uid)).data.target == requestId;
      // 取り下げは論理削除（ADR 0013）: 本人か管理者が withdrawn と updatedAt だけを変え、
      // 持ち主の熱量の印を同じバッチで減らす（管理者の取り下げでも、持ち主の熱量はその分戻る）。
      // 物理削除すると、同期より前に作られた行の取り下げが差分の購読に届かないため。
      // 依頼者が応えた動画を受け取るのも同じ取り下げで、answeredBy（マーカー ID）を足し、炎を answerCounts に移す（T43）。
      allow update: if canWrite()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && resource.data.get('withdrawn', false) == false
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawn', 'updatedAt'])
          || (resource.data.ownerUid == request.auth.uid && answeredNow(requestId)))
        && request.resource.data.withdrawn == true
        && request.resource.data.updatedAt == request.time
        && getAfter(docPath('heatBudgets', resource.data.ownerUid)).data.target == requestId
        // 印が同じバッチでこの熱量ぶん減っていること。印が最初からこのリクエストを指している
        // （最後に作ったリクエスト）とき、印を書かずに取り下げだけを通して熱量を戻らなくするのを防ぐ
        && get(docPath('heatBudgets', resource.data.ownerUid)).data.used
          - getAfter(docPath('heatBudgets', resource.data.ownerUid)).data.used == resource.data.heat;
      // 物理削除は管理者だけ（削除したら同期で公開データを作り直す）
      allow delete: if canWrite() && isAdmin();
    }

    // この書き込みで新しく作られたリクエストが本人のもので、熱量が delta と一致するか
    function pairedRequest(uid, target, delta) {
      let path = docPath('requests', target);
      return !exists(path)
        && existsAfter(path)
        && getAfter(path).data.ownerUid == uid
        && getAfter(path).data.heat == delta;
    }

    // この書き込みで取り下げられた（withdrawn が false から true になった）本人のリクエストで、熱量が delta と一致するか
    function withdrawnRequest(uid, target, delta) {
      let path = docPath('requests', target);
      return exists(path)
        && get(path).data.get('withdrawn', false) == false
        && getAfter(path).data.get('withdrawn', false) == true
        && get(path).data.ownerUid == uid
        && get(path).data.heat == delta;
    }

    function budgetShape() {
      let d = request.resource.data;
      return canWrite()
        && d.keys().hasOnly(['used', 'target'])
        && d.used is int && d.used >= 0 && d.used <= 5
        && reqString(d, 'target', 1, 128);
    }

    // 増やす（リクエストの作成）のは本人だけ。減らす（取り下げ）のは本人か管理者（管理者の取り下げ。要件 5.2.5）。
    // どちらも差分が対象のリクエストの熱量と一致すること
    function validBudget(uid, before) {
      let d = request.resource.data;
      return budgetShape()
        && ((request.auth.uid == uid && d.used > before && pairedRequest(uid, d.target, d.used - before))
          || ((request.auth.uid == uid || isAdmin()) && d.used < before
            && withdrawnRequest(uid, d.target, before - d.used)));
    }

    match /heatBudgets/{uid} {
      // 管理者は、取り下げで減らす値を求めるために読む
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if validBudget(uid, 0);
      allow update: if validBudget(uid, resource.data.used);
      // 消して上限をリセットさせない
      allow delete: if false;
    }

    // ---- 撮影リクエストへの回答（T43・ADR 0028）----
    // 投稿者は、撮影リクエストの地点から動画を登録すると、マーカーの answers にその地点のリクエスト ID を付けられる。
    // 依頼者が「受け取る」と、リクエストを取り下げ（answeredBy を足す）、同じトランザクションで answerCounts/{markerId} に
    // そのリクエストの炎（熱量）を足す。熱量の印も減るので、依頼者の熱量は戻る。
    // answerCounts = { heat: 受け取った炎の合計, count: 件数, ownerUid: 投稿者, last: 最後に受け取ったリクエスト ID }。
    // 誰でも読める（プロフィールで投稿者ごとに合計する）。いいねの likeCounts と同じ方式（ADR 0024）。
    // 受け取りの 1 バッチ（requests・heatBudgets・answerCounts）で get・exists は上限 20 回の近くまで使う。
    // 共通の関数（canWrite など）に get を足すときは、tests/rules/answers.test.mjs の受け取りが通るか確かめる。

    // 応えた動画と頼んだ地点の距離の上限（度。約 1 km）。src/core/logic/answers.ts の ANSWER_NEAR_DEG と同じ
    function nearEnough(m, r) {
      return math.abs(m.lat - r.lat) <= 0.01 && math.abs(m.lng - r.lng) <= 0.01;
    }

    // この書き込みで、依頼者が自分のリクエストを受け取ったか（requests の更新側から見る）
    function answeredNow(requestId) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['withdrawn', 'updatedAt', 'answeredBy'])
        && d.answeredBy is string
        && answerable(d.answeredBy, requestId)
        && getAfter(docPath('answerCounts', d.answeredBy)).data.last == requestId;
    }

    // 応えたマーカーが残っていて、ほかの人の投稿で、このリクエストに応えていて、近くにある。
    // マーカーはリクエストから 3 時間以上たって登録されていること。物理削除のあと同じ ID で作り直して二重に受け取る・
    // まだ無い ID を先に並べておくのを防ぎ、2 つのアカウントで炎を増やす速さを抑える（3 時間は利用者の判断。機器の同期の間隔とそろえた）。
    // resource はリクエストなので get は増えない
    function answerable(markerId, requestId) {
      let m = get(docPath('markers', markerId)).data;
      return m.deleted == false
        && m.ownerUid != request.auth.uid
        && m.get('answers', []).hasAny([requestId])
        && resource.data.createdAt + duration.value(3, 'h') <= m.createdAt
        && nearEnough(m, resource.data);
    }

    // この書き込みで受け取られたリクエストの炎と件数だけ動いたか（answerCounts の側から見る）
    function receivedNow(markerId, requestId) {
      let path = docPath('requests', requestId);
      let d = request.resource.data;
      let heatBefore = resource == null ? 0 : resource.data.heat;
      let countBefore = resource == null ? 0 : resource.data.count;
      return get(path).data.get('withdrawn', false) == false
        && getAfter(path).data.withdrawn == true
        && getAfter(path).data.get('answeredBy', '') == markerId
        && d.heat == heatBefore + get(path).data.heat
        && d.count == countBefore + 1;
    }

    match /answerCounts/{markerId} {
      allow read: if true;
      allow create, update: if canWrite()
        && request.resource.data.keys().hasOnly(['heat', 'count', 'ownerUid', 'last'])
        && request.resource.data.last is string
        && request.resource.data.ownerUid == get(docPath('markers', markerId)).data.ownerUid
        && receivedNow(markerId, request.resource.data.last);
      // 管理者が消せるのはマーカーがもう無いときだけ（いいねの件数と同じ）
      allow delete: if canWrite() && isAdmin() && !exists(docPath('markers', markerId));
    }

    // ---- 通報（要件 3.8）----
    // reports/{markerId}_{uid}。ID を「マーカー × 通報者」にして 1 人 1 件にし、通報した人数を数えられるようにする。
    // 同じ人の 2 回目は、理由と詳細の置き換え（確認待ちに戻す）になる。読めるのは管理者と通報した本人。

    function validReportBody(d) {
      return d.reasons is list && d.reasons.size() >= 1 && d.reasons.size() <= 5
        && d.reasons.toSet().hasOnly(['copyright', 'takedown', 'illegal', 'misleading_location', 'disinformation', 'harassment'])
        && optString(d, 'detail', 1000);
    }

    function validReport(reportId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['markerId', 'reporterUid', 'reasons', 'detail', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['markerId', 'reporterUid', 'reasons', 'status', 'createdAt', 'updatedAt'])
        && reqString(d, 'markerId', 1, 128)
        && reportId == d.markerId + '_' + request.auth.uid
        && d.reporterUid == request.auth.uid
        && validReportBody(d)
        && d.status == 'open'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && exists(docPath('markers', d.markerId));
    }

    function reportAgain() {
      let d = request.resource.data;
      return resource.data.reporterUid == request.auth.uid
        && d.diff(resource.data).affectedKeys().hasOnly(['reasons', 'detail', 'status', 'updatedAt'])
        && validReportBody(d)
        && d.status == 'open'
        && d.updatedAt == request.time;
    }

    match /reports/{reportId} {
      // まだ無い文書は、自分の ID（…_自分の uid）のときだけ読める（画面が「通報済みか」を確かめるため）。
      // 他人の ID まで読めると、読めたかどうかで他人の通報の有無が分かってしまう（T71）。
      // uid は正規表現につなぐので、英数字だけの uid（Google ログイン）に限る。管理者の判定（exists）は最後に回す
      allow read: if signedIn() && (
        (resource == null && request.auth.uid.matches('[A-Za-z0-9]+') && reportId.matches('.+_' + request.auth.uid))
        || (resource != null && resource.data.reporterUid == request.auth.uid)
        || isAdmin());
      allow create: if canWrite() && registered() && validReport(reportId);
      // 対応済みにする・消すのは管理者。本人は理由と詳細を置き換えて、確認待ちに戻せる
      allow update: if canWrite() && (isAdmin() || reportAgain());
      allow delete: if canWrite() && isAdmin();
    }

    // ---- いいね（ADR 0016・0024）----
    // likes/{markerId}_{uid} = { markerId, likerUid, deleted, createdAt, updatedAt }。ID を「マーカー × 本人」にして 1 人 1 件にする。
    // 外すのは論理削除（deleted: true）で、もう一度付けると false に戻す。誰が付けたかは本人と管理者にしか読ませない。
    // 件数は likeCounts/{markerId} = { count, ownerUid } に置き、誰でも読める。いいねと同じ書き込みで ±1 させる。
    // いいね側は「件数がちょうど 1 動いたこと」、件数側は「この書き込みで本人のいいねが付いた（外れた）こと」を見る。
    // 付けるときだけレートリミットの印を求める。外せるのは付けた回数までなので、連打しても書き込みは増えない。

    function likePath(markerId) {
      return docPath('likes', markerId + '_' + request.auth.uid);
    }

    // この書き込みの前・後に、本人のいいねが付いているか
    function likedBefore(markerId) {
      return exists(likePath(markerId)) && get(likePath(markerId)).data.deleted == false;
    }

    function likedAfter(markerId) {
      return existsAfter(likePath(markerId)) && getAfter(likePath(markerId)).data.deleted == false;
    }

    // 件数がこの書き込みで delta だけ動いたか
    function countMoved(markerId, delta) {
      let path = docPath('likeCounts', markerId);
      let before = exists(path) ? get(path).data.count : 0;
      return existsAfter(path) && getAfter(path).data.count == before + delta;
    }

    // 付けられるのは、論理削除されていない他人のマーカーだけ（自分の投稿へのお礼は意味が無い）。
    // 無いマーカーは get がエラーになって拒否される（exists を重ねず、get の回数を上限 10 から離しておく）
    function likeable(markerId) {
      let m = get(docPath('markers', markerId)).data;
      return m.deleted == false && m.ownerUid != request.auth.uid;
    }

    function likeShape(likeId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['markerId', 'likerUid', 'deleted', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['markerId', 'likerUid', 'deleted', 'createdAt', 'updatedAt'])
        && reqString(d, 'markerId', 1, 128)
        && likeId == d.markerId + '_' + request.auth.uid
        && d.likerUid == request.auth.uid
        && d.deleted is bool
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    function likeOn(markerId) {
      return registered() && likeable(markerId) && stampedFor(markerId) && countMoved(markerId, 1);
    }

    // 外す。マーカーが物理削除されて件数の文書も無いときは、件数を動かさずに外せる
    function likeOff(markerId) {
      let path = docPath('likeCounts', markerId);
      return countMoved(markerId, -1) || (!exists(path) && !existsAfter(path));
    }

    match /likes/{likeId} {
      // まだ無い文書は、自分の ID のときだけ読める（画面が「付けているか」を確かめるため）。
      // 他人の ID まで許すと、読めたかどうかで「その人が付けたことがあるか」が分かってしまう。
      // uid は正規表現につなぐので、英数字だけの uid（Google ログイン）に限る（T86）
      allow get: if signedIn() && (
        (resource == null && request.auth.uid.matches('[A-Za-z0-9]+') && likeId.matches('^.+_' + request.auth.uid + '$'))
        || (resource != null && resource.data.likerUid == request.auth.uid)
        || isAdmin());
      // 一覧は本人の分だけ（アカウント削除でまとめて外すため）と管理者
      allow list: if signedIn() && (resource.data.likerUid == request.auth.uid || isAdmin());
      allow create: if canWrite()
        && likeShape(likeId)
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time
        && likeOn(request.resource.data.markerId);
      allow update: if canWrite()
        && resource.data.likerUid == request.auth.uid
        && likeShape(likeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt'])
        && request.resource.data.deleted != resource.data.deleted
        && (request.resource.data.deleted ? likeOff(resource.data.markerId) : likeOn(resource.data.markerId));
      // 物理削除は管理者だけ。件数を動かさずに消せるのは、外したいいねか、マーカーがもう無いものだけ
      // （付いたままのいいねを消すと、件数が実際より多いまま戻せなくなる）
      allow delete: if canWrite() && isAdmin()
        && (resource.data.deleted == true || !exists(docPath('markers', resource.data.markerId)));
    }

    match /likeCounts/{markerId} {
      allow read: if true;
      // 最初のいいねで作る。投稿者の uid はマーカーから写す（自分の投稿で受け取った件数を数えるため）
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['count', 'ownerUid'])
        && request.resource.data.count == 1
        && request.resource.data.ownerUid == get(docPath('markers', markerId)).data.ownerUid
        && !likedBefore(markerId)
        && likedAfter(markerId);
      allow update: if canWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && ((request.resource.data.count == resource.data.count + 1 && !likedBefore(markerId) && likedAfter(markerId))
          || (request.resource.data.count == resource.data.count - 1 && likedBefore(markerId) && !likedAfter(markerId)));
      // 管理者が消せるのはマーカーがもう無いときだけ（残っているのに消すと、次のいいねから数え直して件数が狂う）
      allow delete: if canWrite() && isAdmin() && !exists(docPath('markers', markerId));
    }

    // ---- 機器マスタ（ADR 0025・T28）----
    // equipmentMaster/{分類のキー}。管理者が画面で直した分類だけを置き、3 時間ごとの機器の同期が equipment.json を作り直す。
    // 分類のキーは validEquipment と同じ（空文字を除く）。分類そのものの追加はコードの変更に残す。
    // 入れ子の中身（名前の長さ・重複）はルールでは検査しきれないので、画面と同期が検査する。ここは形と件数の上限だけ。

    function validEquipmentMaster(category) {
      let d = request.resource.data;
      return category in ['drone', 'mirrorless', 'cinema', 'action', 'gimbal', 'camera360', 'smartphone', 'camcorder', 'other']
        && d.keys().hasOnly(['makers', 'updatedAt'])
        && d.keys().hasAll(['makers', 'updatedAt'])
        && d.makers is list && d.makers.size() <= 60
        && d.updatedAt == request.time;
    }

    match /equipmentMaster/{category} {
      // 同期（Actions）が API キーだけで読むので、誰でも読める。誰が直したか（管理者の uid）は置かない（admins は伏せているため）
      allow read: if true;
      allow create, update: if canWrite() && isAdmin() && validEquipmentMaster(category);
      // 「既定に戻す」は置かない（利用者の判断）。戻すときは既定の中身を書き直して保存する
      allow delete: if false;
    }

    // ---- プロフィール（要件 1.1・2.5・2.6・ADR 0019）----
    // users/{uid}。uid は Firebase Auth の uid なので Google アカウントに紐づく。
    // 持つのはニックネームと同意の記録だけ（メールや本名は保存しない）。読めるのは本人と管理者。
    // ほかのユーザーに見せる YouTube チャンネルは publicProfiles/{uid}（下。T55）。

    // 索引（nicknames/{キー}）の文書 ID に使えない形（/ を含む・. と ..・__ で囲む）も拒否する
    function validNickname(d) {
      return d.nickname is string
        && d.nickname.size() >= 1 && d.nickname.size() <= 20
        && d.nickname.matches('[^\\r\\n/]+')
        && d.nickname.trim() == d.nickname
        && !(d.nickname in ['.', '..'])
        && !d.nickname.matches('__.*__')
        // 運営の名前（公式の紹介の投稿者。ADR 0036）は名乗らせない
        && !d.nickname.lower().matches('.*loca.*運営.*');
    }

    // 公開プロフィールの YouTube チャンネル（T55・ADR 0029）: チャンネル ID（UC＋22 字）か @ハンドル（3〜30 字。日本語なども通す）
    function validChannel(c) {
      return c is string && (c.matches('^UC[A-Za-z0-9_-]{22}$') || c.matches('^@[^\\s/?#@%\\\\\\p{Cc}\\p{Cf}]{3,30}$'));
    }

    // ---- ニックネームの重複の禁止（ADR 0019 決定 9）----
    // nicknames/{キー} = { uid }。キーはニックネームを小文字にしたもの（大文字小文字だけの違いも同じ名前とみなす）。
    // 作成は無いときだけ通るので、同じ名前は 1 人しか持てない。プロフィールの登録・変更と同じバッチで作らせる。

    function nicknameKey(nickname) {
      return nickname.lower();
    }

    // この書き込みのあと、nickname の索引が uid のものになっているか
    function holdsNickname(uid, nickname) {
      let path = docPath('nicknames', nicknameKey(nickname));
      return existsAfter(path) && getAfter(path).data.uid == uid;
    }

    // 名前を変えたら、古い名前の索引を同じバッチで手放す（買い占めさせない）
    function releasedOld(uid) {
      let before = nicknameKey(resource.data.nickname);
      let path = docPath('nicknames', before);
      return before == nicknameKey(request.resource.data.nickname)
        || !existsAfter(path)
        || getAfter(path).data.uid != uid;
    }

    match /nicknames/{key} {
      // 登録前に「使われているか」を確かめるため、ログイン済みなら 1 件ずつ読める（一覧は出さない）
      allow get: if signedIn();
      allow list: if false;
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key == nicknameKey(getAfter(docPath('users', request.auth.uid)).data.nickname);
      allow update: if false;
      // 本人は、いまのニックネームでなくなった索引だけ手放せる（アカウント削除でプロフィールを消すときも手放せる）
      allow delete: if canWrite() && (
        isAdmin()
        || (resource.data.uid == request.auth.uid
          && (!existsAfter(docPath('users', request.auth.uid))
            || key != nicknameKey(getAfter(docPath('users', request.auth.uid)).data.nickname)))
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 同意は全項目そろったときだけ作れる（画面が全部の印を求める）。同意の版と日時を記録する
      allow create: if canWrite()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'consentVersion', 'agreedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['nickname', 'consentVersion', 'agreedAt', 'createdAt', 'updatedAt'])
        && validNickname(request.resource.data)
        && request.resource.data.consentVersion == 1
        && holdsNickname(uid, request.resource.data.nickname)
        && request.resource.data.agreedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 本人が変えられるのはニックネームだけ（要件 2.6）。変えるたびに本人のマーカーの投稿者名も書き換えるので、
      // 付け替えの繰り返しで書き込みを増やされないよう、前の登録・変更から 60 秒あける
      allow update: if canWrite()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt'])
        && validNickname(request.resource.data)
        && holdsNickname(uid, request.resource.data.nickname)
        && releasedOld(uid)
        && request.resource.data.updatedAt == request.time
        && request.time > resource.data.updatedAt + duration.value(60, 's');
      // アカウント削除（要件 2.7・ADR 0021）。本人は自分のプロフィールを消せる。投稿は先に論理削除する（画面が順に行う）
      // 公開プロフィール（チャンネル）も同じ書き込みで消えていること（消えたアカウントのチャンネルを公開したまま残さない。ADR 0029）
      allow delete: if canWrite() && (isAdmin() || request.auth.uid == uid)
        && !existsAfter(docPath('publicProfiles', uid));
    }

    // ---- 公開プロフィール（T55・ADR 0029）----
    // publicProfiles/{uid} = { channel }。users/{uid} は本人と管理者しか読めないので、ほかのユーザーに見せる YouTube チャンネルだけを
    // 誰でも読める別の文書に置く（投稿者の公開プロフィールからチャンネルへ移れるように）。本人だけが書け、消すとチャンネルの登録を外す
    // 読めるのは 1 件ずつ（公開プロフィールを開いたとき）。一覧は出さない（uid とチャンネルの組をまとめて集めさせない）
    // 購読はしない（開いたときに 1 件読む）。本人が消せる例外（ADR 0013・0021 の論理削除の決まりの外。ADR 0029）
    match /publicProfiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canWrite()
        && request.auth.uid == uid
        && existsAfter(docPath('users', uid))
        && request.resource.data.keys().hasOnly(['channel'])
        && validChannel(request.resource.data.get('channel', null))
        && (resource == null || request.resource.data.channel != resource.data.channel);
      allow delete: if canWrite() && (isAdmin() || request.auth.uid == uid);
    }

    // ---- 管理者とブラックリスト（要件 5.x）----
    // 追加・削除は管理者だけ。本人は自分の行があるかどうかだけ読める（表示の切り替え用）

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 昇格（T75）: 管理者が、プロフィール登録済みでブラックリストに入っていない人を足す。形は { note, addedAt }
      allow create: if canWrite() && isAdmin()
        && request.resource.data.keys().hasOnly(['note', 'addedAt'])
        && reqString(request.resource.data, 'note', 1, 200)
        && request.resource.data.addedAt == request.time
        && existsAfter(docPath('users', uid))
        && !existsAfter(docPath('blacklist', uid));
      // 付けたあとの書き換えはしない（外して付け直す）
      allow update: if false;
      // 一般に戻す（T75）: 先に管理者になった人だけが、後から管理者になった人を戻せる（addedAt の古い順。無い初期の文書はいちばん古い）。
      // 自分自身・同時に付いた人・自分より古い人は戻せないので、互いに外し合って 0 人になることも、昇格した直後の人が
      // ほかの管理者を全員外すこともできない。いちばん古い管理者はオーナーの CLI（scripts/admins.mjs）でだけ外せる
      allow delete: if canWrite() && isAdmin() && uid != request.auth.uid
        && adminSince(request.auth.uid) < adminSince(uid);
    }

    // 管理者になった時刻（無い初期の文書は epoch 0 として、いちばん古い扱い）
    function adminSince(u) {
      return get(docPath('admins', u)).data.get('addedAt', timestamp.value(0));
    }

    // 定期処理の記録（ADR 0017）。Actions が IAM の経路で書き、管理者だけが読む
    match /jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /blacklist/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 管理者はブラックリストに入れられない（先に一般に戻す。T75）。管理者同士で締め出し合わせないため
      allow create, update: if canWrite() && isAdmin() && !existsAfter(docPath('admins', uid));
      allow delete: if canWrite() && isAdmin();
    }
  }
}
