# ============================================================
# Loca 環境変数テンプレート
#   cp .env.example .env.local して使う。.env* は git 管理外。
#   すべて未設定でもサイトは動く（閲覧だけになり、ログイン・投稿・通報が出なくなる）。
# ============================================================

# --- 公開データの置き場（index.html からの相対）----------------
VITE_DATA_BASE_URL=./data

# --- 配信先のベースパス ----------------------------------------
# 未設定なら './'（相対）。GitHub Pages はこのままでよい。
VITE_BASE_PATH=

# --- Firebase（ログインと保存。ADR 0010） --------------------------
# Firebase コンソール → プロジェクトの設定 → マイアプリ（loca-web）の firebaseConfig の値。
# 4 つのうち 1 つでも欠けると、ログインと保存が無効のまま起動する。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- 地域の調査（T128。スクリプトだけが読む。ブラウザには配らない） ----------
# YouTube Data API だけに制限した調べもの専用のキー。node scripts/setup-survey-key.mjs が書き込む（ADR 0017 の追記）。
# VITE_ で始めないこと（Vite がブラウザに配る）。
YOUTUBE_SURVEY_API_KEY=
